\newcommand{\gvsuStartDocument}{%
  \RaggedRight
  \sloppy
  \hypersetup{pageanchor=false}%
  \pagenumbering{arabic}%
  \setcounter{page}{1}%
}

\newcommand{\gvsuMakeTitlePage}{%
  \begin{titlepage}
  \thispagestyle{empty}
  \centering
  \singlespacing
  \vspace*{0.75in}
  {\bfseries\begin{minipage}{5.85in}\centering\gvsu@title\end{minipage}\par}
  \vspace{2\baselineskip}
  \gvsu@author\par
  \vfill
  A Thesis Submitted to the Graduate Faculty of\par
  \vspace{\baselineskip}
  {\bfseries GRAND VALLEY STATE UNIVERSITY}\par
  \vspace{\baselineskip}
  In\par
  \vspace{\baselineskip}
  Partial Fulfillment of the Requirements\par
  \vspace{\baselineskip}
  For the Degree of\par
  \vspace{\baselineskip}
  {\bfseries \gvsu@degree}\par
  \vfill
  \gvsu@college\par
  \vspace{2\baselineskip}
  \gvsu@month\ \gvsu@year\par
  \vspace*{0.15in}
  \end{titlepage}
}

\newcommand{\gvsuMakeApprovalPage}{%
  \begin{titlepage}
  \thispagestyle{empty}
  \centering
  \doublespacing
  \vspace*{0.5in}
  \begin{minipage}{6.1in}
  \centering
  The signatories of the committee members below indicate that they have read and approved the thesis of \textbf{\gvsu@author} in partial fulfillment of the requirements for the degree of \textbf{\gvsu@degree}.
  \end{minipage}\par
  \vspace{1.5\baselineskip}
  \begin{tabular}{p{6.1in}}
  \rule{6.1in}{0.4pt}\\[-0.2\baselineskip]
  \gvsu@chair, Thesis Committee Chair \hfill Date\\[1.1\baselineskip]
  \rule{6.1in}{0.4pt}\\[-0.2\baselineskip]
  \gvsu@membera, Committee Member \hfill Date\\[1.1\baselineskip]
  \rule{6.1in}{0.4pt}\\[-0.2\baselineskip]
  \gvsu@memberb, Committee Member \hfill Date
  \end{tabular}
  \ifgvsu@hasmemberc
    \vspace{1.1\baselineskip}
    \begin{tabular}{p{6.1in}}
    \rule{6.1in}{0.4pt}\\[-0.2\baselineskip]
    \gvsu@memberc, Committee Member \hfill Date
    \end{tabular}
  \fi
  \vfill
  \begin{tabular}{p{2.85in}p{2.85in}}
  Accepted and approved on behalf of the \gvsu@college &
  Accepted and approved on behalf of the Graduate Faculty \\[1.0\baselineskip]
  \rule{2.75in}{0.4pt} & \rule{2.75in}{0.4pt}\\[-0.2\baselineskip]
  \gvsu@deanunit & \gvsu@deangrad\\[1.0\baselineskip]
  \rule{2.75in}{0.4pt} & \rule{2.75in}{0.4pt}\\[-0.2\baselineskip]
  Date & Date
  \end{tabular}
  \end{titlepage}
}

\newcommand{\gvsuStartFrontMatter}{%
  \begingroup
  \makeatletter
  \addtocontents{toc}{\protect\contentsline{chapter}{Title Page}{1}{section*.1}\protected@file@percent}
  \addtocontents{toc}{\protect\contentsline{chapter}{Approval Page}{2}{section*.2}\protected@file@percent}
  \makeatother
  \endgroup
  \setcounter{page}{3}%
  \hypersetup{pageanchor=true}%
}

\newcommand{\gvsuTableOfContents}{%
  \cleardoublepage
  \phantomsection
  \addcontentsline{toc}{chapter}{Table of Contents}
  {\singlespacing\tableofcontents}
}

\newcommand{\gvsuListOfTables}{%
  \cleardoublepage
  \phantomsection
  \addcontentsline{toc}{chapter}{List of Tables}
  {\singlespacing\listoftables}
}

\newcommand{\gvsuListOfFigures}{%
  \cleardoublepage
  \phantomsection
  \addcontentsline{toc}{chapter}{List of Figures}
  {\singlespacing\listoffigures}
}

\newcommand{\gvsuAppendicesStart}{%
  \cleardoublepage
  \phantomsection
  \addcontentsline{toc}{chapter}{Appendices}
  \chapter*{Appendices}
}

\newcommand{\gvsuAppendixEntry}[1]{%
  \phantomsection
  \addcontentsline{toc}{section}{#1}
  \noindent{\normalfont\normalsize\bfseries #1\par}
  \vspace{2\baselineskip}
}
