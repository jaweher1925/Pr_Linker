\urlstyle{same}
\hypersetup{hidelinks,colorlinks=false,pdfborder={0 0 0}}

\emergencystretch=4em
\hfuzz=0.1pt
\hbadness=10000
\Urlmuskip=0mu plus 2mu\relax

\renewcommand{\textsc}[1]{\MakeUppercase{#1}}

\setlength{\cftbeforechapskip}{1\baselineskip}
\setlength{\cftbeforesecskip}{0.5\baselineskip}
\setlength{\cftbeforefigskip}{0.75\baselineskip}
\setlength{\cftbeforetabskip}{0.75\baselineskip}
\cftsetindents{section}{2.2em}{3.2em}
\cftsetindents{figure}{0em}{3.2em}
\cftsetindents{table}{0em}{3.2em}
\renewcommand{\cftfigpresnum}{Figure\ }
\renewcommand{\cfttabpresnum}{Table\ }
\settowidth{\cftfignumwidth}{Figure\ 10.10\quad}
\settowidth{\cfttabnumwidth}{Table\ 10.10\quad}
\renewcommand{\contentsname}{TABLE OF CONTENTS}
\renewcommand{\cfttoctitlefont}{\hfill\normalfont\normalsize\bfseries}
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\cftloftitlefont}{\hfill\normalfont\normalsize\bfseries}
\renewcommand{\cftafterloftitle}{\hfill}
\renewcommand{\cftlottitlefont}{\hfill\normalfont\normalsize\bfseries}
\renewcommand{\cftafterlottitle}{\hfill}
\setlength{\cftbeforetoctitleskip}{-14pt}
\setlength{\cftbeforeloftitleskip}{-14pt}
\setlength{\cftbeforelottitleskip}{-14pt}
\setlength{\cftaftertoctitleskip}{2\baselineskip}
\setlength{\cftafterloftitleskip}{2\baselineskip}
\setlength{\cftafterlottitleskip}{2\baselineskip}
\renewcommand{\cftchapleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftchappresnum}{Chapter\ }
\settowidth{\cftchapnumwidth}{Chapter\ 10\quad}
\renewcommand{\listtablename}{LIST OF TABLES}
\renewcommand{\listfigurename}{LIST OF FIGURES}

\titleformat{\chapter}[display]
  {\centering\normalfont\normalsize\bfseries}
  {\MakeUppercase{\chaptertitlename}\ \thechapter}
  {1em}
  {\MakeUppercase}
\titlespacing*{\chapter}{0pt}{-\baselineskip}{2\baselineskip}

\titleformat{name=\chapter,numberless}[block]
  {\centering\normalfont\normalsize\bfseries}
  {}{0pt}
  {\MakeUppercase}
\titlespacing*{name=\chapter,numberless}{0pt}{-\baselineskip}{2\baselineskip}

\titleformat{\section}
  {\normalfont\normalsize\bfseries}
  {\thesection}{1em}{}
\titlespacing*{\section}{0pt}{2\baselineskip}{\baselineskip}
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsection}{1em}{}
\titlespacing*{\subsection}{0pt}{\baselineskip}{0.5\baselineskip}
\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsubsection}{1em}{}
\titlespacing*{\subsubsection}{0pt}{\baselineskip}{0.5\baselineskip}

\captionsetup{font=normalsize,labelfont=bf}
\setlength{\parindent}{0.5in}
\setlength{\RaggedRightParindent}{\parindent}
\doublespacing

\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\setlength{\headheight}{14.5pt}
\setlength{\footskip}{0.5in}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

