\newcommand{\gvsu@year}{Year}
\newcommand{\gvsu@chair}{Committee Chair}
\newcommand{\gvsu@membera}{Committee Member}
\newcommand{\gvsu@memberb}{Committee Member}
\newcommand{\gvsu@memberc}{}
\newif\ifgvsu@hasmemberc
\newcommand{\gvsu@deanunit}{Dean of the College}
\newcommand{\gvsu@deangrad}{Dean of The Graduate School}

\newcommand{\gvsuThesisTitle}[1]{\gdef\gvsu@title{#1}}
\newcommand{\gvsuAuthor}[1]{\gdef\gvsu@author{#1}}
\newcommand{\gvsuDegree}[1]{\gdef\gvsu@degree{#1}}
\newcommand{\gvsuCollege}[1]{\gdef\gvsu@college{#1}}
\newcommand{\gvsuGraduationMonth}[1]{\gdef\gvsu@month{#1}}
\newcommand{\gvsuGraduationYear}[1]{\gdef\gvsu@year{#1}}
\newcommand{\gvsuCommitteeChair}[1]{\gdef\gvsu@chair{#1}}
\newcommand{\gvsuCommitteeMemberA}[1]{\gdef\gvsu@membera{#1}}
\newcommand{\gvsuCommitteeMemberB}[1]{\gdef\gvsu@memberb{#1}}
\newcommand{\gvsuCommitteeMemberC}[1]{\gdef\gvsu@memberc{#1}\gvsu@hasmemberctrue}
