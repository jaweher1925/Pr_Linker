\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gvsu-thesis}[2026/05/23 Unofficial GVSU thesis formatting]

\newif\ifgvsu@draftfonts
\DeclareOption{draftfonts}{\gvsu@draftfontstrue}
\ProcessOptions\relax

\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{gvsu-thesis}{Compile with XeLaTeX or LuaLaTeX, not pdfLaTeX}{Open your compiler settings and choose XeLaTeX or LuaLaTeX.}
\fi

\RequirePackage{fontspec}
\defaultfontfeatures{Ligatures=TeX}

\newcommand{\gvsu@settimesfromfiles}{%
  \setmainfont[
    Path=fonts/,
    UprightFont=times.ttf,
    BoldFont=timesbd.ttf,
    ItalicFont=timesi.ttf,
    BoldItalicFont=timesbi.ttf
  ]{Times New Roman}%
  \setsansfont[
    Path=fonts/,
    UprightFont=times.ttf,
    BoldFont=timesbd.ttf,
    ItalicFont=timesi.ttf,
    BoldItalicFont=timesbi.ttf
  ]{Times New Roman}%
  \setmonofont[
    Path=fonts/,
    UprightFont=times.ttf,
    BoldFont=timesbd.ttf,
    ItalicFont=timesi.ttf,
    BoldItalicFont=timesbi.ttf
  ]{Times New Roman}%
}

\newcommand{\gvsu@settimesfromsystem}{%
  \setmainfont{Times New Roman}%
  \setsansfont{Times New Roman}%
  \setmonofont{Times New Roman}%
}

\ifgvsu@draftfonts
  \IfFontExistsTF{TeX Gyre Termes}{%
    \PackageWarning{gvsu-thesis}{Using draft font TeX Gyre Termes. Use Times New Roman before submission.}%
    \setmainfont{TeX Gyre Termes}%
    \setsansfont{TeX Gyre Termes}%
    \setmonofont{TeX Gyre Cursor}%
  }{%
    \PackageWarning{gvsu-thesis}{Draft font not found; trying Times New Roman.}%
    \gvsu@settimesfromsystem
  }%
\else
  \IfFileExists{fonts/times.ttf}{%
    \gvsu@settimesfromfiles
  }{%
    \IfFontExistsTF{Times New Roman}{%
      \gvsu@settimesfromsystem
    }{%
      \PackageError{gvsu-thesis}{Times New Roman was not found}{Install Times New Roman, upload private font files to fonts/, or use [draftfonts] only for drafts.}%
    }%
  }%
\fi

\RequirePackage[left=1in,right=1in,top=1in,bottom=1in]{geometry}
\RequirePackage{setspace}
\RequirePackage{fancyhdr}
\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{enumitem}
